---
import Layout from '../../layouts/Layout.astro';
import ShortEmbed from '../../components/ShortEmbed.astro';
import { UGC_CLIPS, UGC_ON_LOCATION, UGC_TESTIMONIALS } from '../../data/ugc-portfolio';

const pageTitle = 'UGC Creator for Travel, Food & Lifestyle Brands';
const pageDescription = "UGC creator for TikTok, Reels and Shorts: unboxings, reviews, try-ons and voiceover ads that sound like a customer. Shooting on location in Asia now.";
const SITE = 'https://itsaydrian.com';
const PERSON_REF = { '@type': 'Person', '@id': `${SITE}/#person`, name: 'Aydrian Howard', url: `${SITE}/` };

const places = UGC_ON_LOCATION.places;
const placesText = places.length > 1 ? `${places.slice(0, -1).join(', ')} and ${places[places.length - 1]}` : places[0];
const heroAlt = 'Aydrian taking a selfie with a cocktail at a marble table in a pink restaurant, under a pink pendant lamp and tropical leaf wallpaper.';

const FORMATS = [
  { title: 'Talking head', body: 'Reviews and testimonials straight to camera, the way a customer would tell a friend.' },
  { title: 'Unboxing and hauls', body: 'First impressions on camera, with the product in frame and the details legible.' },
  { title: 'Voiceover over b-roll', body: 'Shot on location, cut to a script, with captions that match the edit.' },
  { title: 'Shop-along and try-on', body: 'In the store, in the hotel, in the product. The walk-through format for retail and travel.' },
  { title: 'Hook variations', body: 'Three openers on the same body, so your ads team can test the first three seconds.' },
  { title: 'Captions and post copy', body: 'On-screen captions and a post caption written to match the cut, ready to publish.' },
];

const DELIVERABLE_OPTIONS = ['Talking head', 'Unboxing or haul', 'Voiceover over b-roll', 'Shop-along or try-on', 'Hook variations', 'Raw footage', 'Captions and post copy'];
const USAGE_OPTIONS = ['Organic only', 'Paid ads', 'Whitelisting or Spark Ads', 'Not sure yet'];
// Answers here are rendered on the page and as FAQPage structured data, so keep them in sync by editing only this list.
const FAQS = [
  {
    q: 'What is a UGC creator?',
    a: 'A UGC creator makes videos that look and sound like they came from a real customer, then hands them to the brand to post or run as ads. The brand gets content that feels native to TikTok, Reels and Shorts without booking a production crew.',
  },
  {
    q: 'How much does a UGC video cost?',
    a: 'It depends on the format, how many videos you need and where they will run. Every quote is a fixed price that spells out the usage rights up front, so the number you approve is the number you pay.',
  },
  {
    q: 'What usage rights are included?',
    a: 'Organic use on your own social accounts and website comes with every video. Paid ads on Meta, TikTok or YouTube are licensed for 30 or 90 days, or longer if you need it. Whitelisting, Spark Ads and raw footage are quoted as add-ons.',
  },
  {
    q: 'How long does it take to get the first cut?',
    a: 'It depends on shipping and where I am shooting. Your quote includes a date for the first cut, and one round of revisions is included after that.',
  },
  {
    q: `How does shipping work while you're in ${places.length > 1 ? 'Asia' : placesText}?`,
    a: `I'm on location in ${placesText} through ${UGC_ON_LOCATION.through}. Tell me where the product ships from in your brief, and I'll send an address that lines up with the shoot dates.`,
  },
  {
    q: 'Will you post the video on your own accounts?',
    a: 'UGC is made for your channels, so posting on mine is not included by default. If you want it on my accounts too, or run as a Spark Ad from my account, say so in the brief and I will quote it.',
  },
];

const BUDGET_OPTIONS = ['Under $250', '$250 to $750', '$750 to $2,000', '$2,000+', 'Not sure yet'];
---
<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="/assets/og/ugc.jpg"
  ogImageAlt="Share card: Sounds like a customer. Not a commercial. Scripted, shot and edited by one person."
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType="image/jpeg"
  overlayHeader={true}
  preloadImage="/assets/ugc-hero-selfie.jpg"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Service',
        '@id': `${SITE}/ugc/#service`,
        name: 'UGC video for brands',
        serviceType: 'UGC video production',
        description: pageDescription,
        url: `${SITE}/ugc/`,
        image: `${SITE}/assets/og/ugc.jpg`,
        provider: PERSON_REF,
        areaServed: 'Worldwide',
        availableChannel: { '@type': 'ServiceChannel', serviceUrl: `${SITE}/ugc/#brief` },
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: 'UGC formats',
          itemListElement: FORMATS.map((f) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: f.title, description: f.body },
          })),
        },
      },
      {
        '@type': 'FAQPage',
        '@id': `${SITE}/ugc/#faq`,
        mainEntity: FAQS.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      },
      ...UGC_CLIPS.map((clip) => ({
        '@type': 'VideoObject',
        name: clip.title,
        description: clip.note,
        thumbnailUrl: `${SITE}/assets/ugc/${clip.slug}.jpg`,
        uploadDate: clip.uploadDate,
        duration: clip.duration,
        embedUrl: `https://www.youtube.com/embed/${clip.youtubeId}`,
        url: `https://www.youtube.com/shorts/${clip.youtubeId}`,
        creator: PERSON_REF,
      })),
    ],
  })} />

  <!-- ============================== HERO ============================== -->
  <section class="hero ugc-hero" aria-labelledby="ugc-hero-title">
    <div class="hero-image">
      <picture>
        <source media="(max-width: 800px)" srcset="/assets/ugc-hero-selfie-900.jpg">
        <img src="/assets/ugc-hero-selfie.jpg" alt={heroAlt} width="1440" height="1920" fetchpriority="high">
      </picture>
    </div>

    <div class="container hero-inner">
      <span class="eyebrow rise" data-delay="1" style="color:var(--ink-on-image);">UGC creator · Travel, food and lifestyle</span>
      <h1 id="ugc-hero-title" class="hero-title rise" data-delay="2">
        Sounds like a customer.<br><em>Not a commercial.</em>
      </h1>
      <p class="hero-tagline rise" data-delay="3">
        I'm Aydrian, a one-person content studio. I write, shoot and edit every video myself, so you deal with one
        accountable person from the brief to the final export.
      </p>
      <div class="hero-cta rise" data-delay="4">
        <a class="btn btn-primary btn-lg" href="#brief">
          Send a brief
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="#work">See the work</a>
      </div>
      <p class="ugc-location rise" data-delay="4">
        <span class="ugc-location-dot" aria-hidden="true"></span>
        On location in {placesText} through {UGC_ON_LOCATION.through}
      </p>
    </div>

    <a href="#work" class="hero-scroll" aria-label="Read on — scroll to the work">Read on</a>
  </section>

  <!-- ============================== WORK ============================== -->
  <section class="section section-soft" id="work" aria-labelledby="work-heading">
    <div class="container">
      <header class="section-head rise">
        <span class="eyebrow">The work</span>
        <h2 id="work-heading" class="h2">Recent UGC videos, <em>shot and cut by me.</em></h2>
        <p class="lede">Each one is a format you can brief. Press play to watch it here.</p>
      </header>

      <ul class="ugc-grid" role="list">
        {UGC_CLIPS.map((clip, i) => (
          <li class="ugc-clip rise" data-delay={String((i % 3) + 1)}>
            <ShortEmbed id={clip.youtubeId} title={clip.title} poster={`/assets/ugc/${clip.slug}.jpg`} posterAlt={clip.posterAlt} />
            <div class="ugc-clip-body">
              <div class="ugc-clip-meta">
                <span class="pill pill-cool">{clip.category}</span>
                <span class="eyebrow">{clip.format}</span>
              </div>
              <h3>{clip.title}</h3>
              <p>{clip.note}</p>
              {clip.link && <a class="btn-link ugc-clip-link" href={clip.link.href}>{clip.link.label}</a>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================== FORMATS ============================== -->
  <section class="section" id="formats" aria-labelledby="formats-heading">
    <div class="container">
      <header class="section-head rise">
        <span class="eyebrow">What I make</span>
        <h2 id="formats-heading" class="h2">Formats your team <em>already knows how to use.</em></h2>
        <p class="lede">Vertical, captioned, and ready for TikTok, Instagram Reels, YouTube Shorts or your ad account.</p>
      </header>

      <ul class="ugc-formats" role="list">
        {FORMATS.map((f, i) => (
          <li class="ugc-format rise" data-delay={String((i % 3) + 1)}>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============================== WHY ME ============================== -->
  <section class="section section-soft" id="why" aria-labelledby="why-heading">
    <div class="container ugc-why">
      <header class="section-head rise">
        <span class="eyebrow">Who you're getting</span>
        <h2 id="why-heading" class="h2">The customer <em>most rosters skip.</em></h2>
      </header>
      <div class="ugc-why-body">
        <p class="rise" data-delay="1">
          I'm an elder millennial, over 40, late-diagnosed neurodivergent, and traveling solo across Asia with a
          camera in my pocket. If your buyer is a Gen X or millennial adult with money and no patience for ads
          that talk down to them, I sound like them because I am one.
        </p>
        <p class="rise" data-delay="2">
          Before this I spent twenty years in <a href="/consulting/">tech</a> explaining complicated products in plain
          language, and these days I also plan trips as a <a href="/travel/">travel advisor</a>. That habit is why the
          benefit lands in the first three seconds and the claim holds up to a skeptical viewer.
        </p>
        <ul class="card-meta rise" data-delay="3" role="list" aria-label="Content areas">
          <li class="pill">Travel and hotels</li>
          <li class="pill">Japan and Korea</li>
          <li class="pill">Tech and gadgets</li>
          <li class="pill">Food and snacks</li>
          <li class="pill">Pop culture merch</li>
          <li class="pill">Pet products with Atticus, my corgi</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================== USAGE ============================== -->
  <section class="section" id="usage" aria-labelledby="usage-heading">
    <div class="container">
      <header class="section-head rise">
        <span class="eyebrow">Usage and add-ons</span>
        <h2 id="usage-heading" class="h2">Clear rights, <em>priced up front.</em></h2>
        <p class="lede">Every quote spells out where the video can run and for how long, so nobody gets surprised later.</p>
      </header>

      <dl class="ugc-usage">
        <div class="ugc-usage-row rise" data-delay="1">
          <dt>Organic</dt>
          <dd>Post it on your own social accounts and website. Included with every video.</dd>
        </div>
        <div class="ugc-usage-row rise" data-delay="2">
          <dt>Paid ads</dt>
          <dd>Run it as an ad on Meta, TikTok or YouTube. Licensed for 30 or 90 days, or longer if you need it.</dd>
        </div>
        <div class="ugc-usage-row rise" data-delay="3">
          <dt>Whitelisting and Spark Ads</dt>
          <dd>Run the ad from my account so it reads as a creator post, not a brand post.</dd>
        </div>
        <div class="ugc-usage-row rise" data-delay="4">
          <dt>Raw footage</dt>
          <dd>Every usable clip from the shoot, so your editors can cut their own versions.</dd>
        </div>
      </dl>
    </div>
  </section>

  {UGC_TESTIMONIALS.length > 0 && (
    <section class="section section-soft" id="testimonials" aria-labelledby="testimonials-heading">
      <div class="container">
        <header class="section-head rise">
          <span class="eyebrow">From brands</span>
          <h2 id="testimonials-heading" class="h2">What it's like <em>to work together.</em></h2>
        </header>
        <ul class="ugc-quotes" role="list">
          {UGC_TESTIMONIALS.map((t) => (
            <li class="rise">
              <blockquote>
                <p>{t.quote}</p>
                <footer>{t.name}, <cite>{t.brand}</cite></footer>
              </blockquote>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ============================== PROCESS ============================== -->
  <section class={`section ${UGC_TESTIMONIALS.length > 0 ? '' : 'section-soft'}`} id="process" aria-labelledby="process-heading">
    <div class="container">
      <header class="section-head rise">
        <span class="eyebrow">How it works</span>
        <h2 id="process-heading" class="h2">Brief in. <em>First cut back.</em></h2>
      </header>

      <ol class="ugc-steps" role="list">
        <li class="rise" data-delay="1">
          <span class="eyebrow">01</span>
          <h3>Brief</h3>
          <p>Tell me the product, the promise and where the video will run. The form below covers it.</p>
        </li>
        <li class="rise" data-delay="2">
          <span class="eyebrow">02</span>
          <h3>Quote and plan</h3>
          <p>I reply with a price, the usage terms, and a short script or shot list for you to approve.</p>
        </li>
        <li class="rise" data-delay="3">
          <span class="eyebrow">03</span>
          <h3>Shoot and first cut</h3>
          <p>You ship the product, I shoot it on location and send back a first cut with captions.</p>
        </li>
        <li class="rise" data-delay="4">
          <span class="eyebrow">04</span>
          <h3>Revise and deliver</h3>
          <p>One round of revisions is included. Final files come in the formats you asked for.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ============================== BRIEF FORM ============================== -->
  <section class="section" id="brief" aria-labelledby="brief-heading">
    <div class="container ugc-brief">
      <header class="section-head rise">
        <span class="eyebrow">Send a brief</span>
        <h2 id="brief-heading" class="h2">Tell me the product <em>and the promise.</em></h2>
        <p class="lede">
          Rough is fine. I'll come back with a quote and a plan. Prefer email? Write to{' '}
          <a href="mailto:howdy@itsaydrian.com?subject=UGC%20brief">howdy@itsaydrian.com</a>.
        </p>
      </header>

      <form class="brief-form rise" id="brief-form" novalidate>
        <div class="brief-row">
          <div class="brief-field">
            <label for="brief-name">Your name</label>
            <input id="brief-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          </div>
          <div class="brief-field">
            <label for="brief-email">Email</label>
            <input id="brief-email" name="email" type="email" autocomplete="email" required maxlength="200" />
          </div>
        </div>

        <div class="brief-row">
          <div class="brief-field">
            <label for="brief-brand">Brand or company</label>
            <input id="brief-brand" name="brand" type="text" autocomplete="organization" required maxlength="120" />
          </div>
          <div class="brief-field">
            <label for="brief-product">Product link <span class="brief-optional">(optional)</span></label>
            <input id="brief-product" name="product" type="url" inputmode="url" placeholder="https://" maxlength="500" />
          </div>
        </div>

        <fieldset class="brief-field brief-checks">
          <legend>What do you need? <span class="brief-optional">(pick any)</span></legend>
          <div class="brief-check-grid">
            {DELIVERABLE_OPTIONS.map((opt, i) => (
              <label class="brief-check" for={`brief-deliv-${i}`}>
                <input id={`brief-deliv-${i}`} type="checkbox" name="deliverables" value={opt} />
                <span>{opt}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="brief-row brief-row-3">
          <div class="brief-field">
            <label for="brief-usage">Where will it run?</label>
            <select id="brief-usage" name="usage">
              {USAGE_OPTIONS.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </div>
          <div class="brief-field">
            <label for="brief-budget">Budget</label>
            <select id="brief-budget" name="budget">
              {BUDGET_OPTIONS.map((opt) => <option value={opt} selected={opt === 'Not sure yet'}>{opt}</option>)}
            </select>
          </div>
          <div class="brief-field">
            <label for="brief-timeline">Timeline <span class="brief-optional">(optional)</span></label>
            <input id="brief-timeline" name="timeline" type="text" placeholder="e.g. live by Dec 15" maxlength="120" />
          </div>
        </div>

        <div class="brief-field">
          <label for="brief-message">The brief</label>
          <textarea id="brief-message" name="message" rows="6" required maxlength="5000" placeholder="What's the product, who's it for, and what should a viewer feel or do after watching?"></textarea>
        </div>

        <div class="brief-hp" aria-hidden="true">
          <label for="brief-website">Website</label>
          <input id="brief-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="brief-actions">
          <button type="submit" class="btn btn-primary btn-lg brief-submit">
            <span class="brief-submit-text">Send the brief</span>
            <span class="brief-submit-loading" hidden>Sending…</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </button>
          <p class="brief-status" role="status" aria-live="polite" hidden></p>
        </div>
      </form>
    </div>
  </section>

  <!-- ============================== FAQ ============================== -->
  <section class="section section-soft" id="faq" aria-labelledby="faq-heading">
    <div class="container ugc-faq">
      <header class="section-head rise">
        <span class="eyebrow">Questions brands ask</span>
        <h2 id="faq-heading" class="h2">Hiring a UGC creator, <em>answered.</em></h2>
      </header>
      <div class="ugc-faq-list">
        {FAQS.map((f, i) => (
          <details class="ugc-faq-item rise" data-delay={String((i % 3) + 1)} open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.brief-status')!;
    const submit = form.querySelector<HTMLButtonElement>('.brief-submit')!;
    const submitText = form.querySelector<HTMLElement>('.brief-submit-text')!;
    const submitLoading = form.querySelector<HTMLElement>('.brief-submit-loading')!;

    const show = (type: 'success' | 'error', message: string) => {
      status.hidden = false;
      status.dataset.type = type;
      status.textContent = message;
    };

    const setLoading = (loading: boolean) => {
      submit.disabled = loading;
      submitText.hidden = loading;
      submitLoading.hidden = !loading;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.hidden = true;

      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector<HTMLElement>(':invalid');
        firstInvalid?.focus();
        show('error', 'Please fill in your name, email, brand and the brief.');
        return;
      }

      setLoading(true);
      try {
        const res = await fetch('/api/brief/', { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.success) {
          form.reset();
          show('success', "Got it. I'll reply by email with a quote and a plan.");
        } else {
          show('error', data.error || 'Something went wrong. Please try again, or email howdy@itsaydrian.com.');
        }
      } catch {
        show('error', 'Something went wrong. Please try again, or email howdy@itsaydrian.com.');
      } finally {
        setLoading(false);
      }
    });
  }
</script>

<style>
  /* ---------- Hero ---------- */
  /* The hero photo is a vertical selfie, so on wide screens it takes the right
     side of the hero and fades into the dark background behind the type,
     instead of being stretched full-bleed under it. */
  .ugc-hero .hero-image { overflow: hidden; }
  .ugc-hero .hero-image picture { display: block; height: 100%; }
  .ugc-hero .hero-image img { object-position: 50% 32%; transform-origin: 60% 40%; }

  @media (min-width: 900px) {
    .ugc-hero .hero-image {
      left: 50%;
      /* Fade the photo itself into the hero background, so there is no edge to
         show. The fade is short so the phone in the selfie stays visible. */
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.6) 7%, #000 18%);
      mask-image: linear-gradient(90deg, transparent 0%, rgba(0, 0, 0, 0.6) 7%, #000 18%);
    }
    .ugc-hero .hero-image::after {
      background:
        linear-gradient(90deg, rgba(10, 12, 16, 0.45) 0%, rgba(10, 12, 16, 0) 22%),
        linear-gradient(180deg, rgba(8, 10, 15, 0.55) 0%, rgba(8, 10, 15, 0) 22%),
        linear-gradient(180deg, rgba(8, 10, 15, 0) 62%, rgba(8, 10, 15, 0.6) 88%, rgba(8, 10, 15, 0.9) 100%);
    }
  }

  @media (min-width: 900px) and (max-width: 1199px) {
    .ugc-hero .hero-image { left: 52%; }
  }

  @media (max-width: 899px) {
    /* Photo stacked above the type: it fills the top of the hero and fades
       out where the headline starts, so the text never sits on the face. */
    .ugc-hero { min-height: auto; }
    .ugc-hero .hero-image {
      bottom: auto;
      height: 58vh;
      height: 58svh;
      -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 55%, transparent 100%);
    }
    .ugc-hero .hero-image img { object-position: 50% 28%; }
    .ugc-hero .hero-inner { padding-top: calc(48vh - 88px); padding-top: calc(48svh - 88px); }
    .ugc-hero .hero-image::after {
      background:
        linear-gradient(180deg, rgba(8, 10, 15, 0.5) 0%, rgba(8, 10, 15, 0) 24%, rgba(10, 12, 16, 0.4) 60%, #0a0c10 100%);
    }
  }

  .ugc-location {
    margin-top: var(--space-8);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-14);
    color: rgba(244, 239, 238, 0.85);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .ugc-location-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-hot);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-hot) 30%, transparent);
    flex-shrink: 0;
  }

  /* ---------- Work grid ---------- */
  .ugc-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-10) var(--space-8);
  }

  @media (max-width: 960px) {
    .ugc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .ugc-grid { grid-template-columns: 1fr; max-width: 340px; margin-inline: auto; }
  }

  .ugc-clip {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .ugc-clip-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .ugc-clip-meta {
    display: flex;
