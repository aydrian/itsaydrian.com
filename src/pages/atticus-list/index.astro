---
import Layout from "../../layouts/Layout.astro";
import PickCard from "../../components/PickCard.astro";
import PickTracking from "../../components/PickTracking.astro";
import { CATEGORIES, PICKS, REVIEWED } from "../../data/atticus-picks";

const pageTitle = "Atticus's Favorite Things";
const pageDescription =
  "A corgi-tested gear list, written by the corgi. Toys, treats, supplements, and walking gear we actually use.";

const featuredPicks = PICKS.filter((p) => p.featured);

const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: PICKS.map((pick, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: pick.name,
    url: pick.link,
  })),
};
---

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Atticus's Favorite Things",
    "description": "A corgi-tested gear list, written by the corgi. Toys, treats, supplements, and walking gear we actually use.",
    "url": "https://itsaydrian.com/atticus-list",
    "publisher": { "@type": "Organization", "name": "ItsAydrian LLC" }
  }
</script>
<script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />

<Layout
  title="Atticus's Favorite Things"
  description={pageDescription}
  ogImage="/assets/atticus-hero.jpg"
  ogImageAlt="Atticus the corgi smiling."
  ogImageWidth={1800}
  ogImageHeight={1200}
  ogImageType="image/jpeg"
  preloadImage="/assets/atticus-hero.jpg"
>
  <section class="atticus-hero">
    <div class="container">
      <figure class="atticus-hero-banner rise">
        <img
          src="/assets/atticus-hero.jpg"
          alt="Atticus the corgi looking out across a Manhattan street."
          fetchpriority="high"
        />
        <span class="atticus-hero-banner-tag" aria-hidden="true"
          >★ Chief Corgi Officer</span
        >
      </figure>

      <div class="atticus-hero-text">
        <span class="eyebrow rise" data-delay="1"
          >Atticus's favorite things</span
        >
        <h1 class="display rise" data-delay="2">
          <em>Atticus's</em> favorite things.
        </h1>
        <p class="lede rise" data-delay="3">
          A corgi-tested gear list, written by the corgi. Toys, treats,
          supplements, and walking gear we actually use.
        </p>
        <p class="atticus-affiliate rise" data-delay="4">
          As an Amazon Associate I earn from qualifying purchases.
        </p>
      </div>
    </div>
  </section>

  <div class="container">
    <section class="section">
      <h2 class="h2 rise">Start here</h2>
      <p class="body rise" data-delay="1">
        If you only buy one thing from each shelf, start here.
      </p>
      <div class="product-grid pick-start-grid">
        {featuredPicks.map((pick) => (
          <PickCard pick={pick} />
        ))}
      </div>
    </section>

    <section class="section">
      <h2 class="h2 rise">Browse by category</h2>
      <div class="category-tiles">
        {CATEGORIES.map((cat) => {
          const count = PICKS.filter((p) => p.category === cat.id).length;
          return (
            <a class="card category-tile" href={`/atticus-list/${cat.id}/`}>
              <span class="category-tile-emoji" aria-hidden="true">{cat.emoji}</span>
              <span class="category-tile-label">{cat.label}</span>
              <span class="category-tile-count body-sm">{count} {count === 1 ? "pick" : "picks"}</span>
            </a>
          );
        })}
      </div>
    </section>

    <section class="section">
      <h2 class="h2 rise">All {PICKS.length} picks</h2>
      {CATEGORIES.map((cat) => (
        <section class="section-anchor pick-category-block" id={cat.id}>
          <h3 class="h3">
            <span class="emoji" aria-hidden="true">{cat.emoji}</span> {cat.label}
          </h3>
          <div class="product-grid" style="margin-top: var(--space-6);">
            {PICKS.filter((p) => p.category === cat.id).map((pick) => (
              <PickCard pick={pick} />
            ))}
          </div>
        </section>
      ))}
    </section>

    <p class="body-sm pick-freshness">{PICKS.length} picks · reviewed {REVIEWED}</p>
  </div>

  <PickTracking />
</Layout>

<style>
  .pick-start-grid {
    margin-top: var(--space-10);
  }

  .category-tiles {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .category-tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .category-tiles {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .category-tile {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
    text-decoration: none;
  }

  .category-tile-emoji {
    font-size: var(--fs-32);
  }

  .category-tile-label {
    font-weight: 600;
    color: var(--ink);
  }

  .category-tile-count {
    color: var(--ink-faint);
  }

  .pick-category-block {
    margin-top: var(--space-12);
  }

  .pick-category-block h3 {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
  }

  .pick-category-block h3 .emoji {
    font-size: 0.65em;
  }

  .pick-freshness {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
  }
</style>
