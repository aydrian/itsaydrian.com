---
// ===== EDIT LINKS HERE =====
type LinkItem = { label: string; description: string; href: string; kind: "affiliate" | "external" | "internal" };
type LinkSection = { id: string; heading: string; links: LinkItem[] };
const SECTIONS: LinkSection[] = [
  { id: "book", heading: "Book tours & experiences", links: [
    { label: "Viator", description: "Tours, day trips and activities across Japan.", href: "https://www.viator.com/?pid=P00058688&uid=U00655990&mcid=58086", kind: "affiliate" },
    { label: "GetYourGuide", description: "Skip-the-line tickets and guided experiences.", href: "https://www.getyourguide.com?partner_id=UBHY2VI&travel_agent=1&cmp=share_to_earn", kind: "affiliate" }
  ]},
  { id: "work", heading: "Work with me", links: [
    { label: "Travel advising", description: "Itineraries, hotels, trains and restaurants, planned by someone who goes to Japan every year.", href: "/travel/", kind: "internal" }
  ]},
  { id: "follow", heading: "Follow along", links: [
    { label: "YouTube", description: "Japan travel videos, and the longer edits as they come together.", href: "https://www.youtube.com/@itsaydrian", kind: "external" },
    { label: "TikTok", description: "Short videos from the road.", href: "https://www.tiktok.com/@itsaydrian?_r=1&_t=ZP-9B3ZMeOAynW", kind: "external" },
    { label: "Instagram", description: "Photos and stories between trips.", href: "https://instagram.com/itsaydrian", kind: "external" }
  ]}
];
// ===== SHOP MY PICKS ===== add { label, description, href: "https://amzn.to/...", kind: "affiliate" } entries here.
// Renders only when non-empty. Amazon disclosure line appears automatically when it is.
const SHOP_LINKS: LinkItem[] = [
  {
    label: "MOFT Snap Tripod Stand & Wallet",
    description: "Card holder that folds into a phone tripod, so you can film hands-free without packing one.",
    href: "https://link.amazon/B0ce6VuWY",
    kind: "affiliate",
  },
  {
    label: "GL.iNet Beryl 7 Travel Router",
    description: "Pocket Wi-Fi 7 router that puts every device on one private network, with the VPN handled at the router.",
    href: "https://link.amazon/B04hCWCz5",
    kind: "affiliate",
  },
];
// ===== PET CARE ===== Rover referral. The sitter business is paused; new clients still get $20 off.
const PET_LINKS: LinkItem[] = [
  {
    label: "Rover pet care",
    description: "Sitters, walkers, and boarding in most US cities. New clients get $20 off their first booking, whether it's with me or another sitter.",
    href: "https://www.rover.com/sit/aydrih08941",
    kind: "affiliate",
  },
];

import Layout from '../../layouts/Layout.astro';
import LinkRow from '../../components/LinkRow.astro';
import { getLinksPagePosts } from '../../data/blog';

const BASE_DISCLOSURE = "Some links on this page are affiliate links. If you book or buy through them, I may earn a commission at no extra cost to you.";
const disclosures = [BASE_DISCLOSURE];
if (SHOP_LINKS.length > 0) disclosures.push("As an Amazon Associate I earn from qualifying purchases.");
if (PET_LINKS.length > 0) disclosures.push("Rover referral links may credit me when you book.");
const disclosureText = disclosures.join(" ");

const linksPagePosts = await getLinksPagePosts();
const postLinks: LinkItem[] = linksPagePosts.map((post) => {
  const config = post.linksPage;
  const label = (typeof config === "object" && config.label) || post.title;
  const description = (typeof config === "object" && config.description) || post.excerpt;
  return {
    label,
    description,
    href: `/blog/${post.slug}/`,
    kind: "internal",
  };
});

const hero = SECTIONS.find((section) => section.id === "book");
const rest = SECTIONS.filter((section) => section.id !== "book");
// Render order in one place. Empty lists drop out, so `posts` and `shop` appear only when populated.
const RENDER_ORDER: LinkSection[] = [
  ...(hero ? [hero] : []),
  { id: "posts", heading: "From the blog", links: postLinks },
  { id: "shop", heading: "Shop my picks", links: SHOP_LINKS },
  { id: "pets", heading: "Pet care", links: PET_LINKS },
  ...rest,
].filter((section) => section.links.length > 0);
---
<Layout title="Links" description="Book Japan tours and experiences, work with me on a trip, and follow along. Aydrian Howard, travel advisor.">
  <div class="container-narrow links-page">
    <header class="links-header">
      <img src="/assets/fora-profile.jpg" alt="Aydrian Howard" width="64" height="64" class="links-avatar">
      <h1 class="h2">Aydrian Howard</h1>
      <p class="body-sm">Travel advisor sharing Japan tips from the road.</p>
    </header>

    <p class="body-sm links-disclosure">{disclosureText}</p>

    {RENDER_ORDER.map((section) => (
      <section id={section.id} aria-labelledby={`${section.id}-label`} class="links-section">
        <h2 class="eyebrow" id={`${section.id}-label`}>{section.heading}</h2>
        <ul role="list" class="link-list">
          {section.links.map((link) => (
            <LinkRow label={link.label} description={link.description} href={link.href} kind={link.kind} section={section.id} />
          ))}
        </ul>
      </section>
    ))}

    <p class="body-sm links-footer">Questions or a trip in mind? <a href="mailto:howdy@itsaydrian.com">howdy@itsaydrian.com</a></p>
  </div>
</Layout>

<style>
  .links-page {
    padding-block: var(--space-16) var(--space-24);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .links-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .links-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: var(--space-2);
  }

  .links-disclosure {
    border-top: 1px solid var(--rule);
    padding-top: var(--space-4);
  }

  .links-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .link-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .links-footer {
    text-align: center;
    margin-top: var(--space-6);
  }
</style>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    const a = target && target.closest ? target.closest("a[data-outbound]") : null;
    if (!a) return;
    if (typeof gtag === "function") {
      gtag("event", "outbound_click", {
        link_url: a.href,
        link_label: a.dataset.label,
        link_section: a.dataset.outbound,
        transport_type: "beacon"
      });
    }
  });
</script>