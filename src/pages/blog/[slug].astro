---
import Layout from '../../layouts/Layout.astro';
import PostCta from '../../components/PostCta.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import PostCard from '../../components/PostCard.astro';
import SubscriberForm from '../../components/SubscriberForm.astro';
import { getAllPosts, getPostBySlug, getRelatedPosts, toSchemaDateTime, categoryUrl, coverVariants } from '../../data/blog';
import { AUTHOR_SCHEMA } from '../../data/author';
import type { BlogPost } from '../../data/blog';

export async function getStaticPaths() {
  const includeDrafts = import.meta.env.DEV || __PREVIEW_BUILD__;
  const allPosts = await getAllPosts({ includeDrafts });
  return allPosts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug as string, {
  includeDrafts: import.meta.env.DEV || __PREVIEW_BUILD__,
});

if (!post) {
  return Astro.redirect('/blog/');
}

const isDraft = !!post.draft;
const includeDrafts = import.meta.env.DEV || __PREVIEW_BUILD__;
const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const formattedDate = formatDate(post.date);
const showUpdated = !!post.updated && new Date(post.updated) > new Date(post.date);
const related = await getRelatedPosts(post, 3, { includeDrafts });
const showToc = post.headings.length >= 4;
const hero = coverVariants(post);

const Content = post.Content;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const metaTitle = post.seoTitle ?? post.title;
const metaDescription = post.seoDescription ?? post.excerpt;
const abs = (path: string) => new URL(path, Astro.site).href;
const schemaImages = [
  ...new Set(
    [post.ogImage ?? "/assets/aydrian-tokyo-hero-1600.jpg", post.coverImage, ...(post.schemaImages ?? [])]
      .filter((p): p is string => !!p)
      .map(abs)
  ),
];
const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: metaDescription,
  image: schemaImages,
  datePublished: post.date,
  dateModified: post.updated ?? post.date,
  author: AUTHOR_SCHEMA,
  publisher: {
    "@type": "Organization",
    "@id": "https://itsaydrian.com/#organization",
    name: "ItsAydrian LLC",
    url: "https://itsaydrian.com/",
    logo: { "@type": "ImageObject", url: "https://itsaydrian.com/assets/itsaydrian-logo.png" },
  },
  timeRequired: `PT${post.readingTime}M`,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
  articleSection: post.category,
  inLanguage: "en",
  url: canonicalUrl,
};
const videoSchema = post.video && {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: post.video.title,
  description: post.video.description ?? metaDescription,
  thumbnailUrl: [`https://i.ytimg.com/vi/${post.video.id}/maxresdefault.jpg`],
  uploadDate: toSchemaDateTime(post.video.uploadDate),
  ...(post.video.duration ? { duration: post.video.duration } : {}),
  contentUrl: `https://www.youtube.com/watch?v=${post.video.id}`,
  embedUrl: `https://www.youtube.com/embed/${post.video.id}`,
};
---

<Layout title={isDraft ? `${metaTitle} (Draft)` : metaTitle} description={metaDescription} ogType="article" articlePublished={post.date} articleModified={post.updated ?? post.date} articleSection={post.category} ogImage={post.ogImage} ogImageAlt={post.ogImageAlt} ogImageWidth={post.ogImageWidth} ogImageHeight={post.ogImageHeight}>
  {isDraft && <meta slot="head" name="robots" content="noindex, nofollow">}
  {!isDraft && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogPostingSchema)} />
  )}
  {!isDraft && videoSchema && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify(videoSchema)} />
  )}

  {isDraft && (
    <div class="draft-banner" role="status" aria-live="polite">
      <span class="draft-badge">Draft</span>
      <span class="draft-message">This is a preview of an unpublished post. Do not share.</span>
    </div>
  )}

  <article class="container-narrow post">
    <header class:list={['post-header', hero && 'has-hero']}>
      <div class="post-header-text">
    <Breadcrumbs
      schema={!isDraft}
      items={[
        { label: 'Home', href: '/' },
        { label: 'Blog', href: '/blog/' },
        { label: post.category, href: categoryUrl(post.category) },
        { label: post.title, href: `/blog/${post.slug}/` },
      ]}
    />

      <div class="post-meta">
        <a class="pill post-pill" href={categoryUrl(post.category)}>{post.category}</a>
        <span class="post-date">
          <time datetime={post.date}>{formattedDate}</time>
          {showUpdated && (
            <>
              <span aria-hidden="true"> · </span>
              Updated <time datetime={post.updated}>{formatDate(post.updated!)}</time>
            </>
          )}
          <span aria-hidden="true"> · </span>
          {post.readingTime} min read
        </span>
      </div>
      <h1 class="h1 post-title">{post.title}</h1>
      <p class="lede">{post.excerpt}</p>
      {!isDraft && (
        <div class="post-header-share">
          <ShareButtons url={canonicalUrl} title={post.title} image={post.coverImage ?? post.ogImage} variant="compact" />
        </div>
      )}
      </div>
      {hero && (
        <div class="post-hero">
          <img
            src={hero.src}
            srcset={hero.srcset}
            sizes={hero.srcset ? '(min-width: 1080px) 500px, (min-width: 900px) 42vw, 92vw' : undefined}
            alt={post.coverImageAlt ?? ''}
            width="1200"
            height="1600"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )}
    </header>

    {showToc && <TableOfContents headings={post.headings} />}

    <div class="prose">
      {Content ? <Content /> : <Fragment set:html={post.fullContent} />}
    </div>

    {!isDraft && post.cta !== false && <PostCta />}

    {!isDraft && <ShareButtons url={canonicalUrl} title={post.title} image={post.coverImage ?? post.ogImage} heading="Found this useful? Pass it on." />}

    <AuthorBox />
  </article>

  {related.length > 0 && (
    <section class="section section-soft related" aria-labelledby="related-heading">
      <div class="container">
        <div class="related-head">
          <h2 id="related-heading" class="h2">Keep reading</h2>
          <a class="btn-link" href="/blog/">
            All posts
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="blog-grid">
          {related.map((p, i) => <PostCard post={p} delay={i === 0 ? undefined : String(i)} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section post-subscribe" aria-labelledby="subscribe-heading">
    <div class="container" style="text-align: center; max-width: 640px;">
      <span class="eyebrow">Stay in the loop</span>
      <h2 id="subscribe-heading" class="h2">Get the next post by email.</h2>
      <p class="lede">No spam. Just travel notes, app updates, and occasional Atticus content.</p>
      <div style="margin-top: var(--space-8);">
        <SubscriberForm tag="blog" />
      </div>
      <p class="body-sm rss-note">Prefer a feed reader? <a href="/rss.xml">Follow the RSS feed</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .draft-banner {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--accent);
    color: var(--bg);
    text-align: center;
  }

  .draft-badge {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.25em 0.6em;
    border-radius: var(--r-sm);
    background: var(--bg);
    color: var(--accent);
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .draft-message {
    font-size: var(--fs-14);
    font-weight: 500;
  }

  .post {
    padding-block: var(--space-12) var(--space-24);
  }

  .post-pill {
    text-decoration: none;
  }
  .post-pill:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .related-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .rss-note {
    margin-top: var(--space-6);
    color: var(--ink-faint);
  }

  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 96px;
  }


  .post-header {
    margin-top: var(--space-8);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--rule);
  }

  .post-header :global(.breadcrumbs) {
    margin-bottom: var(--space-8);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .post-date {
    font-size: var(--fs-14);
    color: var(--ink-faint);
  }

  .post-title {
    margin-bottom: var(--space-4);
    text-wrap: balance;
  }

  /* Hero: cover photo beside the title on desktop, under the lede on phones.
     Covers are 3:4 portraits (often selfies), so a 4:5 crop biased upward
     keeps faces in frame. */
  .post-header.has-hero {
    display: flex;
    flex-direction: column;
  }
  .post-header.has-hero .post-header-text {
    display: contents;
  }
  .post-header.has-hero .post-hero {
    order: 1;
    margin-top: var(--space-8);
  }
  .post-header.has-hero .post-header-share {
    order: 2;
  }

  .post-hero img {
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 62svh;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: var(--r-lg);
    background: var(--bg-soft);
  }

  @media (min-width: 900px) {
    /* Break out of the 880px reading column so the title has room. */
    .post-header.has-hero {
      --hero-w: min(1140px, calc(100vw - 2 * var(--gutter)));
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-12);
      align-items: center;
      width: var(--hero-w);
      margin-inline: calc((100% - var(--hero-w)) / 2);
    }
    .post-header.has-hero .post-header-text {
      display: block;
    }
    .post-header.has-hero .post-title {
      font-size: clamp(2.5rem, 4.2vw, 3.5rem);
    }
    .post-header.has-hero .post-hero {
      margin-top: 0;
    }
    .post-hero img {
      max-height: 640px;
    }
  }

  .prose :global(p) {
    font-size: var(--fs-18);
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: var(--space-6);
  }
  .prose :global(p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: var(--fs-44);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: var(--fs-32);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
  }
  .prose :global(a:not(.btn)) {
    color: var(--accent);
  }
  .prose :global(a:not(.btn):hover) {
    color: var(--accent-hover);
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-6);
    margin-left: 0;
    color: var(--ink-soft);
    font-style: italic;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-8);
    margin-bottom: var(--space-6);
  }
  .prose :global(li) {
    font-size: var(--fs-18);
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    margin-block: var(--space-8);
  }

  /* Portrait photos show narrower and centered so one photo doesn't fill
     the screen. Post photos are exported at 680x907 (3:4), so match that;
     add class="portrait" to any other tall image. A fixed width (not
     width:auto) keeps lazy images sized before they load. */
  .prose :global(img:is([width="680"][height="907"], .portrait)) {
    width: min(100%, 440px);
    margin-inline: auto;
  }

  /* Inside a PhotoPair each photo fills its column. */
  .prose :global(.photo-pair img) {
    width: 100%;
    max-height: none;
    margin: 0;
  }

  .prose :global(figure) {
    margin: 0;
    margin-block: var(--space-8);
  }

  .prose :global(figcaption) {
    font-size: var(--fs-14);
    color: var(--ink-faint);
    text-align: center;
    margin-top: var(--space-2);
  }

  /* expressive-code sets its own dark bg — only add structural props */
  .prose :global(.astro-code) {
    padding: var(--space-4);
    border-radius: var(--r-md);
    margin-block: var(--space-6);
    overflow-x: auto;
  }

  /* plain pre blocks without expressive-code */
  .prose :global(pre:not(.astro-code)) {
    background: var(--bg-soft);
    padding: var(--space-4);
    border-radius: var(--r-md);
    margin-block: var(--space-6);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    font-family: var(--font-mono);
    font-size: var(--fs-14);
    background: none;
    padding: 0;
    border-radius: 0;
    color: inherit;
  }

  /* inline code only */
  .prose :global(:not(pre) > code) {
    background: var(--bg-soft);
    color: var(--ink-soft);
    padding: 0.15em 0.35em;
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin-block: var(--space-10);
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .prose :global(em) {
    font-style: italic;
  }
</style>
