---
import Layout from '../../layouts/Layout.astro';
import SubscriberForm from '../../components/SubscriberForm.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import { getAllPosts, getAllCategoriesAsync } from '../../data/blog';

const pageTitle = "Blog";
const pageDescription = "Notes on travel, Japan, apps, and life in New York. Written by Aydrian Howard.";

const includeDrafts = import.meta.env.DEV || __PREVIEW_BUILD__;
const posts = await getAllPosts({ includeDrafts });
const categories = await getAllCategoriesAsync({ includeDrafts });
const [featured, ...rest] = posts;

const site = Astro.site ?? new URL('https://itsaydrian.com');
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "ItsAydrian Blog",
  "description": pageDescription,
  "url": new URL('/blog/', site).href,
  "publisher": { "@type": "Organization", "@id": "https://itsaydrian.com/#organization", "name": "ItsAydrian LLC" },
  "blogPost": posts.filter((p) => !p.draft).map((p) => ({
    "@type": "BlogPosting",
    "headline": p.title,
    "url": new URL(`/blog/${p.slug}/`, site).href,
    "datePublished": p.date,
    ...(p.updated ? { "dateModified": p.updated } : {}),
  })),
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="/assets/og/blog.jpg"
  ogImageAlt="Share card: Notes on travel, making things, and New York. Travel guides, Japan finds, apps, and life in the city."
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageType="image/jpeg"
  overlayHeader={true}
  preloadImage="/assets/blog-hero-800.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(blogSchema)} />
  <!-- ============================== HERO ============================== -->
  <section class="hero blog-hero" aria-labelledby="blog-hero-title">
    <div class="hero-image">
      <picture>
        <source media="(max-width: 800px)" srcset="/assets/blog-hero-800.jpg">
        <img src="/assets/blog-hero.jpg" alt="Aydrian in a blue kimono with Yasaka Pagoda in the background, Kyoto." width="2880" height="1920" fetchpriority="high">
      </picture>
    </div>

    <div class="container hero-inner">
      <span class="eyebrow rise">From the desk</span>
      <h1 id="blog-hero-title" class="hero-title rise" data-delay="1">
        Notes on travel,<br>making things,<br><em>and New York.</em>
      </h1>
      <p class="hero-tagline rise" data-delay="2">
        Short dispatches from trips, projects, and whatever Atticus is up to.
      </p>
    </div>

    <a href="#blog-index" class="hero-scroll" aria-label="Read on — scroll to blog posts">Read on</a>
  </section>

  <!-- BLOG INDEX -->
  <section class="section section-soft" id="blog-index" aria-labelledby="blog-heading">
    <div class="container">
      <h2 id="blog-heading" class="visually-hidden">Blog posts</h2>

      <CategoryNav categories={categories} />

      {featured && (
        <div class="blog-featured">
          <PostCard post={featured} variant="featured" />
        </div>
      )}

      {rest.length > 0 && (
        <div class="blog-grid">
          {rest.map((post, index) => (
            <PostCard post={post} delay={index % 3 === 0 ? undefined : String(index % 3)} />
          ))}
        </div>
      )}

      <!-- EMPTY STATE -->
      {posts.length === 0 && (
        <div class="blog-empty blog-empty-all">
          <p class="blog-empty-eyebrow">From the desk</p>
          <h3 class="blog-empty-title">Nothing published yet.</h3>
          <p class="blog-empty-body">I'm drafting a few dispatches. Subscribe below and I'll send a note when the first post goes live.</p>
        </div>
      )}
    </div>
  </section>

  <!-- SUBSCRIBE CTA -->
  <section class="section section-soft">
    <div class="container" style="text-align: center; max-width: 640px;">
      <span class="eyebrow rise">Stay in the loop</span>
      <h2 class="h2 rise" data-delay="1">Get new posts by email.</h2>
      <p class="lede rise" data-delay="2">No spam. Just travel notes, app updates, and occasional Atticus content.</p>
      <div class="rise" data-delay="3" style="margin-top: var(--space-8);">
        <SubscriberForm tag="blog" />
      </div>
      <p class="body-sm rss-note rise" data-delay="3">Prefer a feed reader? <a href="/rss.xml">Follow the RSS feed</a>.</p>
    </div>
  </section>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .rss-note {
    margin-top: var(--space-6);
    color: var(--ink-faint);
  }

  .blog-empty {
    text-align: center;
    padding: var(--space-16) var(--space-6);
    color: var(--ink-soft);
  }

  .blog-empty-all {
    max-width: 52ch;
    margin-inline: auto;
  }

  .blog-empty-eyebrow {
    font-size: var(--fs-12);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: var(--space-4);
  }

  .blog-empty-title {
    font-family: var(--font-display);
    font-size: var(--fs-36);
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  .blog-empty-body {
    font-size: var(--fs-18);
    line-height: 1.6;
  }
</style>
