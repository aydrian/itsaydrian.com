---
/**
 * Visible breadcrumb trail plus matching BreadcrumbList structured data.
 * The last item is the current page and isn't linked.
 */
interface Crumb {
  label: string;
  href: string;
}

interface Props {
  items: Crumb[];
  /** Emit BreadcrumbList JSON-LD into the head slot. Off for drafts. */
  schema?: boolean;
}

const { items, schema = true } = Astro.props;
const site = Astro.site ?? new URL('https://itsaydrian.com');
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    item: new URL(item.href, site).href,
  })),
};
---

{schema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--fs-14);
    font-weight: 500;
    color: var(--ink-faint);
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .breadcrumbs li + li::before {
    content: "/";
    color: var(--rule-strong);
  }

  .breadcrumbs a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .breadcrumbs a:hover {
    color: var(--ink);
  }

  .breadcrumbs [aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 32ch;
  }
</style>
