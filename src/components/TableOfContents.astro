---
/**
 * "In this post" jump list built from a post's h2 headings. Astro gives MDX
 * headings ids automatically, so the links need no extra markup in posts.
 * Collapsed by default on phones (a small script opens it on wider screens),
 * and works as a plain <details> without JavaScript.
 */
interface Props {
  headings: { slug: string; text: string }[];
}

const { headings } = Astro.props;
---

<details class="toc" data-toc>
  <summary class="toc-summary">
    <span>In this post</span>
    <span class="toc-count">{headings.length} sections</span>
    <svg class="toc-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
  </summary>
  <ol class="toc-list">
    {headings.map((h) => (
      <li><a href={`#${h.slug}`}>{h.text}</a></li>
    ))}
  </ol>
</details>

<style>
  .toc {
    margin-bottom: var(--space-12);
    background: var(--bg-card);
    border: 1px solid var(--rule);
    border-radius: var(--r-lg);
  }

  .toc-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    list-style: none;
    font-size: var(--fs-14);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .toc-summary::-webkit-details-marker {
    display: none;
  }
  .toc-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--r-lg);
  }

  .toc-count {
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink-faint);
  }

  .toc-chevron {
    margin-left: auto;
    color: var(--ink-faint);
    transition: transform var(--dur-fast) var(--ease-out-quart);
  }
  .toc[open] .toc-chevron {
    transform: rotate(180deg);
  }

  .toc-list {
    margin: 0;
    padding: 0 var(--space-6) var(--space-6) calc(var(--space-6) + 1.25em);
    columns: 2 260px;
    column-gap: var(--space-8);
  }

  .toc-list li {
    break-inside: avoid;
    padding-block: var(--space-1);
    font-size: var(--fs-16);
    line-height: 1.4;
    color: var(--ink-faint);
  }

  .toc-list a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .toc-list a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .toc-chevron { transition: none; }
  }
</style>

<script>
  if (window.matchMedia('(min-width: 720px)').matches) {
    document.querySelectorAll<HTMLDetailsElement>('[data-toc]').forEach((d) => (d.open = true));
  }
</script>
