---
/**
 * DykerHeightsRouteMap.astro
 *
 * Inline SVG route map for the Dyker Heights Christmas lights post.
 * Geometry is drawn from OpenStreetMap street data (projected, then rotated so the
 * avenue grid runs vertically). No tiles, no API keys, no third-party requests.
 *
 * Usage in an .mdx post:
 *   import DykerHeightsRouteMap from '../components/DykerHeightsRouteMap.astro';
 *   <DykerHeightsRouteMap />
 */
const directions =
  'https://www.google.com/maps/dir/?api=1&origin=86th+St+%26+4th+Ave,+Brooklyn,+NY' +
  '&destination=86th+St+%26+12th+Ave,+Brooklyn,+NY&travelmode=walking';
