---
/**
 * Share links for a blog post. Plain links for each network, so they work
 * without JavaScript; a small script adds "Copy link" and, on devices that
 * support it (mostly phones), the native share sheet.
 *
 * Network links carry data-outbound="share", so the Layout's GA handler logs
 * them as outbound_click events. Every share action (including copy link and
 * the native sheet) also sends GA4's recommended "share" event with the method.
 */
interface Props {
  /** Absolute canonical URL of the post. */
  url: string;
  /** Post title, used as the share text. */
  title: string;
  /** Image for Pinterest, as a site path or absolute URL. */
  image?: string;
  /** Heading shown above the buttons. Omit for the compact row. */
  heading?: string;
  variant?: "compact" | "full";
}

const { url, title, image, heading, variant = "full" } = Astro.props;

const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const tu = encodeURIComponent(`${title} ${url}`);
const media = image ? encodeURIComponent(new URL(image, Astro.site).href) : "";

const networks = [
  {
    name: "Threads",
    href: `https://www.threads.com/intent/post?text=${tu}`,
    path: "M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z",
  },
  {
    name: "Bluesky",
    href: `https://bsky.app/intent/compose?text=${tu}`,
    path: "M5.202 2.857C7.954 4.922 10.913 9.11 12 11.358c1.087-2.247 4.046-6.436 6.798-8.501C20.783 1.366 24 .213 24 3.883c0 .732-.42 6.156-.667 7.037-.856 3.061-3.978 3.842-6.755 3.37 4.854.826 6.089 3.562 3.422 6.299-5.065 5.196-7.28-1.304-7.847-2.97-.104-.305-.152-.448-.153-.327 0-.121-.05.022-.153.327-.568 1.666-2.782 8.166-7.847 2.97-2.667-2.737-1.432-5.473 3.422-6.3-2.777.473-5.899-.308-6.755-3.369C.42 10.04 0 4.615 0 3.883c0-3.67 3.217-2.517 5.202-1.026",
  },
  {
    name: "X",
    href: `https://x.com/intent/post?text=${t}&url=${u}&via=itsaydrian`,
    path: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
  },
  {
    name: "Facebook",
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
  },
  {
    name: "LinkedIn",
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  ...(media
    ? [
        {
          name: "Pinterest",
          href: `https://www.pinterest.com/pin/create/button/?url=${u}&media=${media}&description=${t}`,
          path: "M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.663.967-2.911 2.168-2.911 1.024 0 1.518.769 1.518 1.688 0 1.029-.653 2.567-.992 3.992-.285 1.193.6 2.165 1.775 2.165 2.128 0 3.768-2.245 3.768-5.487 0-2.861-2.063-4.869-5.008-4.869-3.41 0-5.409 2.562-5.409 5.199 0 1.033.394 2.143.889 2.741.099.12.112.225.085.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641.001 12.017 0z",
        },
      ]
    : []),
];

const mailto = `mailto:?subject=${t}&body=${encodeURIComponent(`I thought you'd like this: ${title}\n\n${url}`)}`;
---

<div class:list={["share", `share-${variant}`]} data-share-url={url} data-share-title={title}>
  {heading && <p class="share-heading">{heading}</p>}
  <ul class="share-list" role="list" aria-label="Share this post">
    <li class="share-native-item" hidden>
      <button type="button" class="share-btn share-native" data-label="Native share">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v13"/><path d="m7 8 5-5 5 5"/><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg>
        <span class="share-text">Share</span>
      </button>
    </li>
    {networks.map((n) => (
      <li>
        <a
          class="share-btn"
          href={n.href}
          target="_blank"
          rel="noopener noreferrer"
          data-outbound="share"
          data-label={n.name}
          aria-label={`Share on ${n.name} (opens in a new tab)`}
          title={`Share on ${n.name}`}
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d={n.path} /></svg>
        </a>
      </li>
    ))}
    <li>
      <a class="share-btn" href={mailto} data-outbound="share" data-label="Email" aria-label="Share by email" title="Share by email">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
      </a>
    </li>
    <li>
      <button type="button" class="share-btn share-copy" data-label="Copy link" aria-label="Copy link to this post" title="Copy link">
        <svg class="icon-link" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
        <svg class="icon-check" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      </button>
    </li>
  </ul>
  <span class="share-status" role="status" aria-live="polite"></span>
</div>

<style>
  .share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    position: relative;
  }

  .share-full {
    justify-content: space-between;
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .share-heading {
    font-family: var(--font-display);
    font-size: var(--fs-24);
    line-height: 1.15;
    color: var(--ink);
  }

  .share-full .share-status {
    flex-basis: 100%;
  }

  .share-compact {
    margin-top: var(--space-6);
  }

  .share-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-width: 44px;
    height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--r-pill);
    border: 1px solid var(--rule-strong);
    background: var(--bg-card);
    color: var(--ink-soft);
    font: 500 var(--fs-14) / 1 var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out-quart),
                border-color var(--dur-fast) var(--ease-out-quart),
                background var(--dur-fast) var(--ease-out-quart),
                transform var(--dur-fast) var(--ease-out-quart);
  }

  .share-compact .share-btn {
    min-width: 38px;
    height: 38px;
    padding: 0 var(--space-2);
  }

  @media (max-width: 420px) {
    .share-compact .share-list { gap: 6px; }
    .share-compact .share-btn { min-width: 34px; height: 34px; }
  }

  /* Where the OS share sheet exists (mostly phones), the top row is just
     Share + Copy link; the sheet already lists every app the reader has. */
  .share-compact.has-native .share-list > li:not(.share-native-item):not(:last-child) {
    display: none;
  }

  .share-btn:hover {
    color: var(--bg);
    background: var(--ink);
    border-color: var(--ink);
  }

  .share-btn:active {
    transform: scale(0.94);
  }

  .share-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .share-native {
    padding-inline: var(--space-4);
  }

  .share-copy .icon-check,
  .share-copy.is-copied .icon-link {
    display: none;
  }

  .share-copy.is-copied .icon-check {
    display: block;
  }

  .share-copy.is-copied {
    color: var(--bg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .share-status {
    font-size: var(--fs-14);
    color: var(--ink-faint);
    min-height: 1em;
  }

  .share-status:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .share-btn { transition: none; }
    .share-btn:active { transform: none; }
  }
</style>

<script>
  function track(label: string) {
    const gtag = (window as any).gtag;
    if (typeof gtag === "function") {
      gtag("event", "share", { method: label, content_type: "article", item_id: location.pathname });
    }
  }

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return;
    } catch {
      // Clipboard API blocked (permissions, older browsers): fall back.
    }
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand("copy");
    ta.remove();
    if (!ok) throw new Error("copy failed");
  }

  document.querySelectorAll<HTMLElement>(".share").forEach((root) => {
    const url = root.dataset.shareUrl ?? location.href;
    const title = root.dataset.shareTitle ?? document.title;
    const status = root.querySelector<HTMLElement>(".share-status");

    root.querySelectorAll<HTMLAnchorElement>("a.share-btn").forEach((a) => {
      a.addEventListener("click", () => track(a.dataset.label ?? "link"));
    });

    const nativeItem = root.querySelector<HTMLElement>(".share-native-item");
    if (nativeItem && typeof navigator.share === "function") {
      nativeItem.hidden = false;
      root.classList.add("has-native");
      nativeItem.querySelector("button")?.addEventListener("click", async () => {
        try {
          await navigator.share({ title, url });
          track("native");
        } catch {
          /* user closed the sheet */
        }
      });
    }

    const copyBtn = root.querySelector<HTMLButtonElement>(".share-copy");
    copyBtn?.addEventListener("click", async () => {
      try {
        await copyText(url);
        copyBtn.classList.add("is-copied");
        if (status) status.textContent = "Link copied";
        track("copy_link");
        setTimeout(() => {
          copyBtn.classList.remove("is-copied");
          if (status) status.textContent = "";
        }, 2200);
      } catch {
        if (status) status.textContent = "Couldn't copy. Use the address bar instead.";
      }
    });
  });
</script>
